# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored; .env.local.example is committed so the shape is documented.

# Neon Postgres connection string (Neon dashboard -> Connect -> "Pooled connection").
# Example: postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Auth.js session secret. Generate one with: npx auth secret
# (or: openssl rand -base64 32)
AUTH_SECRET=
